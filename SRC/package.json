{
  "name": "tableflip",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based spreadsheet reporting tool",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint preact/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "esbuild-wasm": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "preact": "^10.29.2"
  }
}

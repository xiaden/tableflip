{
  "name": "tableflip",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based spreadsheet reporting tool",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch -p tsconfig.dev.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint js/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:preact": "node scripts/build-preact.mjs",
    "typecheck:preact": "tsc --noEmit -p preact/tsconfig.json",
    "dev:preact": "tsc --watch -p preact/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.23.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.29.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "preact": "^10.29.2"
  }
}
